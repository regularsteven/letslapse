{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base",    "color": "#0A0F1C", "name": "Base (page)" },
				{ "slug": "surface", "color": "#0D1526", "name": "Surface (card)" },
				{ "slug": "well",    "color": "#060B16", "name": "Well (code / stage)" },
				{ "slug": "hairline","color": "#245A85", "name": "Hairline" },
				{ "slug": "bright",  "color": "#E9EEF6", "name": "Bright text" },
				{ "slug": "contrast","color": "#C6D2E4", "name": "Body text" },
				{ "slug": "muted",   "color": "#8FA1BC", "name": "Muted text" },
				{ "slug": "faint",   "color": "#6E7F99", "name": "Faint text" },
				{ "slug": "accent",  "color": "#F0A32C", "name": "Accent" },
				{ "slug": "amber",   "color": "#FFB340", "name": "Amber" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "tiny",   "name": "Tiny",   "size": "12.5px" },
				{ "slug": "small",  "name": "Small",  "size": "13.5px" },
				{ "slug": "medium", "name": "Medium", "size": "15px" },
				{ "slug": "large",  "name": "Large",  "size": "16px",
				  "fluid": { "min": "15px", "max": "18px" } },
				{ "slug": "x-large","name": "X Large","size": "28px",
				  "fluid": { "min": "24px", "max": "34px" } },
				{ "slug": "display","name": "Display","size": "44px",
				  "fluid": { "min": "30px", "max": "52px" } }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "10px" },
				{ "slug": "20", "name": "2", "size": "16px" },
				{ "slug": "30", "name": "3", "size": "20px" },
				{ "slug": "40", "name": "4", "size": "28px" },
				{ "slug": "50", "name": "5", "size": "clamp(36px, 5vw, 64px)" },
				{ "slug": "60", "name": "6", "size": "clamp(48px, 6vw, 80px)" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"blocks": {
			"core/navigation": {
				"typography": { "customFontSize": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.55"
		},
		"spacing": {
			"padding": {
				"left": "clamp(20px, 5vw, 56px)",
				"right": "clamp(20px, 5vw, 56px)"
			},
			"blockGap": "20px"
		},
		"elements": {
			"caption": {
				"typography": { "fontSize": "12.5px", "lineHeight": "1.5" },
				"color": { "text": "var(--wp--preset--color--faint)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--amber)" },
				"typography": { "textDecoration": "none" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--bright)" },
				"typography": { "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.01em" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--well)"
				},
				"typography": { "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--medium)" },
				"border": { "radius": "12px" },
				"spacing": { "padding": { "top": "13px", "bottom": "13px", "left": "32px", "right": "32px" } },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--amber)",
						"text": "var(--wp--preset--color--well)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "14px",
					"fontWeight": "600",
					"letterSpacing": "0.26em",
					"textTransform": "uppercase"
				},
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						":hover": { "color": { "text": "var(--wp--preset--color--bright)" } }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "13.5px" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--muted)" },
						":hover": { "color": { "text": "var(--wp--preset--color--bright)" } }
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-blank", "title": "Blank (no header/footer)", "postTypes": [ "page" ] }
	]
}
