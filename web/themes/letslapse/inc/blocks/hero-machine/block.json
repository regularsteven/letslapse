{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "letslapse/hero-machine",
	"version": "0.2.0",
	"title": "Blend machine",
	"category": "media",
	"icon": "images-alt2",
	"description": "A live canvas that averages real source frames at 1/N opacity into blended timelapse frames, with a timeline that grows as each frame stacks.",
	"keywords": [ "hero", "timelapse", "blend", "canvas", "letslapse" ],
	"textdomain": "letslapse",
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"multiple": true,
		"spacing": {
			"padding": true,
			"margin": [ "top", "bottom" ]
		},
		"interactivity": { "clientNavigation": false }
	},
	"attributes": {
		"showTimeline": {
			"type": "boolean",
			"default": true
		},
		"showPlayingCount": {
			"type": "boolean",
			"default": true
		},
		"sourceLabel": {
			"type": "string",
			"default": "SOURCE INPUT"
		},
		"outputLabel": {
			"type": "string",
			"default": "BLENDED OUTPUT"
		},
		"timelineLabel": {
			"type": "string",
			"default": "TIMELINE · 1 BLEND = {seconds} S OF SOURCE"
		},
		"replayLabel": {
			"type": "string",
			"default": "Replay the machine"
		},
		"stackingLabel": {
			"type": "string",
			"default": "{stacked} / {ratio} · blend {blend} of {outputs}"
		},
		"playingLabel": {
			"type": "string",
			"default": "playing · blend"
		},
		"resettingLabel": {
			"type": "string",
			"default": "loop restarting…"
		},
		"reducedMotionLabel": {
			"type": "string",
			"default": "Reduced motion — showing the finished stack"
		},
		"blendRatio": { "type": "number" },
		"outputCount": { "type": "number" },
		"frameCount": { "type": "number" },
		"atlasCols": { "type": "number" },
		"atlasFrameSize": { "type": "number" },
		"sourceFps": { "type": "number" },
		"startRate": { "type": "number" },
		"accel": { "type": "number" },
		"maxRate": { "type": "number" },
		"playFps": { "type": "number" },
		"atlasUrl": {
			"type": "string",
			"default": ""
		},
		"atlasId": {
			"type": "number",
			"default": 0
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
