<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The launch screen has to be a real colour, not the system default:
	     an empty UILaunchScreen paints systemBackground, i.e. WHITE in light
	     mode, and on a first install that canvas is held for seconds while
	     dyld loads MLX. That white flash is the thing LaunchAnimationView
	     exists to replace, so the static screen has to already be the field
	     colour the animation starts on.

	     This cannot be expressed as an INFOPLIST_KEY_* build setting —
	     Xcode's plist generator honours UILaunchScreen_Generation but not the
	     nested UIColorName, and silently emits an empty dict. So the target
	     carries a partial Info.plist and lets the generated keys merge in,
	     the same arrangement the Watch target uses for WKBackgroundModes. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!-- `.lapse` project archives. LetsLapse writes them (AppModel.exportProject)
	     and LetsLapse reads them, so we EXPORT the type rather than import it —
	     this declaration is where the identifier comes from.

	     Conforming to public.data and not public.archive is deliberate: the
	     payload is an Apple Archive, but nothing outside LetsLapse can do
	     anything useful with it, and claiming public.archive invites Archive
	     Utility to offer itself as a handler for a file it would unpack into a
	     meaningless folder. With LSHandlerRank Owner, a double-click in Finder
	     comes here. -->
	<!-- The Bonjour service the Mac remote browses for and the camera
	     advertises (CaptureRemoteService.type). Like UILaunchScreen above,
	     this CANNOT be an INFOPLIST_KEY_* build setting: it is an array, and
	     Xcode's plist generator silently emits an empty value for those. An
	     empty NSBonjourServices doesn't error — browsing simply never finds
	     anything, which is indistinguishable from "no cameras on the network".

	     NSLocalNetworkUsageDescription is a plain string and so DOES live in
	     the build settings, alongside the other usage descriptions. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_letslapse-remote._tcp</string>
	</array>

	<!-- Export compliance, answered in the binary so every TestFlight upload
	     processes straight through instead of parking in "Missing Compliance"
	     until someone answers the same question again in the web UI.

	     `false` is the exempt answer, and this app qualifies: it implements no
	     cryptography of its own. Everything it touches is Apple's — CryptoKit
	     SHA256 for cache keys (hashing, not encryption), HKDF-SHA256 to derive
	     the remote's pre-shared key from the pairing code (authentication), and
	     Network.framework TLS for the remote link itself. If a future change
	     adds custom crypto, or encrypts user content at rest with our own
	     scheme, this key has to be revisited — it is a legal declaration, not a
	     build setting. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Opts the Mac build in to AVCaptureDeviceTypeContinuityCamera, so an
	     iPhone in Continuity range is discovered as what it is. Without this
	     key AVFoundation logs "Add NSCameraUseContinuityCameraDeviceType to
	     your Info.plist" and serves the phone under the DEPRECATED
	     AVCaptureDeviceTypeExternal instead — indistinguishable, by type, from
	     a USB webcam. `CameraDevices.connectionLabel` leans on the real type to
	     say "Continuity Camera" rather than "External".

	     Harmless on iOS, which has no Continuity Camera devices to discover. -->
	<key>NSCameraUseContinuityCameraDeviceType</key>
	<true/>

	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.regularsteven.letslapse.project</string>
			<key>UTTypeDescription</key>
			<string>LetsLapse Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>lapse</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>LetsLapse Project</string>
			<!-- Viewer, not Editor: opening one imports a copy into the library
			     and never writes back to the file that was double-clicked. -->
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<!-- Finder draws the document icon by insetting the app icon into a
			     page, rather than us shipping and maintaining a second .icns
			     that would drift from the app icon every time it changes. -->
			<key>CFBundleTypeIconSystemGenerated</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.regularsteven.letslapse.project</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
